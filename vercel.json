{
  "redirects": [
    {
      "source": "/en",
      "destination": "/?lang=en",
      "permanent": false
    },
    {
      "source": "/en/:path*",
      "destination": "/?lang=en",
      "permanent": false
    },
    {
      "source": "/pt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pt/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0748196420.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/evento/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|Slackbot|Slack-ImgProxy|LinkedInBot|Discordbot|TelegramBot|Pinterest|redditbot|SkypeUriPreview|vkShare|Googlebot|bingbot|Applebot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/evento-preview?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/vender-entradas",
      "destination": "/vender-entradas/index.html"
    },
    {
      "source": "/vender-entradas/:slug",
      "destination": "/vender-entradas/:slug.html"
    },
    {
      "source": "/((?!api/|assets|__/).*)",
      "destination": "/index.html"
    }
  ]
}
