# ─────────────────────────────────────────────────────────────
# ENTRA — variables de entorno (cargar en Vercel, proyecto entra-by-der)
# Este archivo es la referencia. NO pongas valores reales aca; van en Vercel.
# ─────────────────────────────────────────────────────────────

# ── MercadoPago (cobro) ──────────────────────────────────────
# Token de la cuenta de ENTRA. Cobra cuando el organizador NO conecto su MP.
MP_ACCESS_TOKEN="APP_USR-..."
# Public key de la cuenta de ENTRA (Checkout Pro). Opcional para el redirect.
MP_PUBLIC_KEY="APP_USR-..."
# Modo sandbox: "true" prueba con tarjetas de test (titular APRO=aprueba),
# "false" (o sin setear) cobra plata real. Dejar en true hasta validar.
MP_SANDBOX="true"

# ── MercadoPago Marketplace / Split (cada organizador cobra a su cuenta) ──
# Credenciales de la app de MP (OAuth). El organizador conecta su MP con el
# boton "Conectar MercadoPago" del Dashboard; ENTRA cobra su comision por split.
MP_CLIENT_ID="..."
MP_CLIENT_SECRET="..."

# ── Firebase Admin SDK (backend de cobro: emite tickets, descuenta stock) ──
# JSON de la service account (proyecto gen-lang-client-0748196420), en una linea.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"..."}'
# OJO: Firestore es una base CON NOMBRE, no la (default). Si no se setea, el
# Admin SDK cae al id real ai-studio-1f48d1a4-8f81-4978-8af2-62a9d8c7f9ea.
FIREBASE_DATABASE_ID="ai-studio-1f48d1a4-8f81-4978-8af2-62a9d8c7f9ea"

# ── URLs ─────────────────────────────────────────────────────
# Base publica del sitio. Se usa para el redirect_uri del OAuth de MP y para
# la notification_url del webhook. En prod: https://www.entratickets.com
PUBLIC_BASE_URL="https://www.entratickets.com"

# ── Legacy AI Studio (opcional, casi sin uso hoy) ────────────
# GEMINI_API_KEY="..."
# APP_URL="..."
