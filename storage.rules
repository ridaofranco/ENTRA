rules_version = '2';

// Reglas de Firebase Storage para imágenes de eventos.
// Lectura pública (la cartelera y la página del evento muestran el flyer).
// Escritura solo para usuarios autenticados (organizadores/admins).
service firebase.storage {
  match /b/{bucket}/o {

    match /event-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024          // máx 5MB
        && request.resource.contentType.matches('image/.*'); // solo imágenes
    }

    // Por defecto, todo lo demás bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
